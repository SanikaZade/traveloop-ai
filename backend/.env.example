# TravelLoop Backend — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/travelloop?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_string

# JWT expiry duration
JWT_EXPIRE=7d

# Server port (Render sets this automatically)
PORT=5000

# Node environment
NODE_ENV=development

# Allowed frontend origin for CORS (set to your Vercel URL in production)
# Leave blank to allow all origins (development)
FRONTEND_URL=https://your-travelloop-frontend.vercel.app
